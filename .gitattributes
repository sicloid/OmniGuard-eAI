* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf

# Migration checksums are taken over the exact file bytes, so a CRLF checkout would be
# recorded history drift against a database migrated from a LF one. Pin the line ending
# rather than normalising inside the runner: the bytes sent to the server are the bytes
# hashed, and that is the property the checksum is meant to prove.
*.sql text eol=lf

# KAN-19 exact-byte freeze pins must survive a Windows checkout.
model/operating_policy_spec.json text eol=lf
model/frozen/kan19-seed1/*.json text eol=lf
model/iforest_spec.json text eol=lf
