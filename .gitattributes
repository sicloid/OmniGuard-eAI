* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
# KAN-41: *.yml was pinned but *.yaml was not, so platform/compose.yaml and the
# Grafana provisioning files were checked out with CRLF on Windows and shipped that
# way into Linux containers. Same gap as the *.nft one KAN-33 closed.
*.yaml text eol=lf
# Only this directory, not *.json: R1's frozen artefacts under data/ and model/ are
# byte-pinned against recorded hashes and are not ours to renormalise.
platform/grafana/dashboards/*.json text eol=lf
*.nft text eol=lf
Dockerfile* text eol=lf

# Migration checksums are taken over the exact file bytes, so a CRLF checkout would be
# recorded history drift against a database migrated from a LF one. Pin the line ending
# rather than normalising inside the runner: the bytes sent to the server are the bytes
# hashed, and that is the property the checksum is meant to prove.
*.sql text eol=lf

# KAN-19 exact-byte freeze pins must survive a Windows checkout.
model/operating_policy_spec.json text eol=lf
model/frozen/kan19-seed1/*.json text eol=lf
model/ablation_spec.json text eol=lf
model/frozen/kan20/*.json text eol=lf
docs/evidence/G8_2026-09-20.json text eol=lf
docs/evidence/G8_2026-09-20_raw/** text eol=lf
model/forest_spec.json text eol=lf
# Exact-byte G10 evidence hashes must match on Windows checkouts as well.
docs/evidence/G10_2026-09-20_raw/* text eol=lf
model/nlease_spec.json text eol=lf
model/frozen/kan51/*.json text eol=lf
model/frozen/kan51/superseded/*.json text eol=lf
data/holdout/score_spec.json text eol=lf
data/holdout/score_record.json text eol=lf
data/holdout/selection.json text eol=lf
